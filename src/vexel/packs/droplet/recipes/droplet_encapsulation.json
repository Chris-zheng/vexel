{
  "schema_version": 1,
  "name": "droplet_encapsulation",
  "description": "droplet_basic plus encapsulation: counts cells inside each droplet (dark spots by default; set inclusions.polarity to bright for fluorescence) and compares the count distribution with a Poisson distribution.",
  "seed": 0,
  "input": {"channel": 0, "z": 0},
  "steps": [
    {
      "id": "bg",
      "op": "preprocess.static_background",
      "inputs": {"image": "source"},
      "params": {"mode": "absdiff", "max_frames": 64}
    },
    {
      "id": "seg",
      "op": "segment.threshold_watershed",
      "inputs": {"image": "bg.image"},
      "params": {"smooth_sigma": 0.5, "method": "otsu", "min_threshold": 15.0, "fill_holes": true, "opening_radius": 2, "min_area": 100, "min_distance": 8},
      "qc": [{"metric": "foreground_fraction.max", "max": 0.6, "on_fail": "warn"}]
    },
    {
      "id": "measure",
      "op": "measure.regionprops",
      "inputs": {"labels": "seg.labels", "intensity": "source"}
    },
    {
      "id": "inclusions",
      "op": "droplet.inclusions",
      "inputs": {"image": "source", "labels": "seg.labels"},
      "params": {"polarity": "dark", "cell_diameter_px": 5.0, "edge_margin_px": 6}
    },
    {
      "id": "track",
      "op": "track.link",
      "inputs": {"table": "measure.table"},
      "params": {"max_distance_px": 30.0, "max_gap_frames": 1}
    },
    {
      "id": "droplets",
      "op": "droplet.summary",
      "inputs": {"table": "track.table", "inclusions": "inclusions.table"},
      "params": {"flow_axis": "x", "count_line": 0.5, "min_track_frames": 3},
      "qc": [
        {"metric": "n_droplets", "min": 2, "on_fail": "warn"},
        {"metric": "circularity_median", "min": 0.8, "on_fail": "warn"}
      ]
    },
    {
      "id": "encapsulation",
      "op": "droplet.poisson",
      "inputs": {"table": "droplets.droplets"},
      "params": {"column": "n_inclusions"},
      "qc": [{"metric": "low_agreement_fraction", "max": 0.1, "on_fail": "warn"}]
    }
  ],
  "review": {"image": "source", "labels": "seg.labels", "marks": "inclusions.labels", "n_frames": 4}
}
