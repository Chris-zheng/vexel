# Copy to .env and fill in only what you use. Never commit .env.

# Network: this computer only by default. 0.0.0.0 opens the workbench to the network;
# requests from other computers then have to sign in.
VEXEL_WEB_HOST=127.0.0.1
# Behind a reverse proxy that sets X-Forwarded-For (otherwise leave unset)
VEXEL_TRUST_PROXY=

# Privacy: no request leaves this computer when set (planning uses the offline rules)
VEXEL_OFFLINE=
# Let images (not only numbers) go to cloud vision models; off by default
VEXEL_ALLOW_IMAGE_UPLOAD=
# Let anyone create an account (default: an administrator creates them)
VEXEL_OPEN_SIGNUP=

# Planning models (optional; without keys the offline rules are used)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Accounts and the governance database
VEXEL_ADMIN_PASSCODE=
VEXEL_SESSION_SECRET=
VEXEL_DB_PATH=

# GPU training worker (deploy/gpu-worker)
VEXEL_GPU_TRAIN_ENDPOINT=
VEXEL_GPU_TRAIN_TOKEN=
VEXEL_GPU_CALLBACK_SECRET=
VEXEL_TRAIN_MAX_WALL_CLOCK_SEC=480

# Local OME-Zarr folder the server may read
VEXEL_ZARR_ROOT=
