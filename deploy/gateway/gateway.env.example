# Vexel AI gateway: environment (copy to /etc/vexel/gateway.env, chmod 600, owner vexel).
# Never commit the real file. The desktop app never sees these keys.

# Model providers (at least one)
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Optional: model names and endpoints (defaults: deepseek-chat, gemini-2.5-flash)
# VEXEL_DEEPSEEK_MODEL=deepseek-chat
# VEXEL_GEMINI_MODEL=gemini-2.5-flash

# Prices in USD per million tokens "input,output", used for the organisations' budgets.
# Check the providers' current price lists and set them here.
# VEXEL_PRICE_DEEPSEEK=0.30,1.20
# VEXEL_PRICE_GEMINI=0.30,2.50

# The database (organisations, invites, users, usage, cache)
VEXEL_GATEWAY_DB=/var/lib/vexel/gateway.db

# Behind Caddy on the same machine: trust its X-Forwarded-For for rate limits
VEXEL_GATEWAY_TRUST_PROXY=1

# Development only: a simulated provider, no keys needed, no cost
# VEXEL_GATEWAY_MOCK=1
